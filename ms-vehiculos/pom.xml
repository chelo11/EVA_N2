<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent oficial de Spring Boot (Maven Central): el modulo queda autocontenido,
         sin depender del POM agregador "biblioteca" del monorepo original. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>cl.matiivilla</groupId>
    <artifactId>cl-matiivilla-vehiculos</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>Modulo de Vehiculos</name>
    <description>Microservicio standalone de Vehiculos (CRUD + Swagger, sin Eureka ni Gateway).</description>

    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <springdoc-openapi.version>2.10.0</springdoc-openapi.version>
        <jacoco.version>0.8.16</jacoco.version>

        <!-- Parches de seguridad sobre el BOM de Spring Boot 3.5.16 (ultima 3.5.x publicada):
             Tomcat 10.1.55 tiene 4 CVE CRITICAL y Jackson 2.21.4 varias HIGH, todas corregidas
             en estas versiones (detectadas por Trivy / OSV). -->
        <tomcat.version>10.1.61</tomcat.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>

        <!-- Politica de calidad: cobertura minima exigida por jacoco:check (falla el build si no se cumple) -->
        <cobertura.lineas.minima>0.80</cobertura.lineas.minima>
        <cobertura.ramas.minima>0.70</cobertura.ramas.minima>

        <!-- SonarCloud (SonarQube Cloud) -->
        <sonar.organization>chelo11</sonar.organization>
        <sonar.projectKey>chelo11_EVA_N2</sonar.projectKey>
        <sonar.projectName>EVA_N2 - ms-vehiculos</sonar.projectName>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- La clase main solo arranca Spring: no aporta logica que probar -->
        <sonar.coverage.exclusions>**/BibliotecaVehiculosApplication.java</sonar.coverage.exclusions>
    </properties>

    <!-- Dependencias minimas: web + JPA + MySQL + validacion + Swagger + Actuator (health checks) -->
    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Expone /actuator/health/liveness y /readiness para las probes de Kubernetes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>cl.matiivilla.vehiculos.BibliotecaVehiculosApplication</mainClass>
                </configuration>
            </plugin>

            <!-- Cobertura de pruebas: reporte (lo consume SonarCloud) + umbral minimo obligatorio -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>cl/matiivilla/vehiculos/BibliotecaVehiculosApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.lineas.minima}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.ramas.minima}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
